{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/share/e/:slug", "destination": "/api/share?kind=e&slug=:slug" },
    { "source": "/share/d/:slug", "destination": "/api/share?kind=d&slug=:slug" },
    { "source": "/((?!api/|share/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
